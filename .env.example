# ─────────────────────────────────────────────────────────────
#  .env.example → .env 로 복사한 뒤 값을 채우세요.   cp .env.example .env
#  .env 는 .gitignore 에 포함되어 Git 에 올라가지 않습니다.
#
#  ⚠️ VITE_ 로 시작하는 값은 "빌드 결과물(JS)에 그대로 포함되어 누구나 볼 수 있습니다."
#     따라서 여기에는 브라우저에 공개되어도 되는 Public 키만 넣어야 합니다.
#     - OK  : Supabase anon(publishable) 키, 카카오 JavaScript 키, 네이버 지도 Client ID
#     - 금지 : Supabase service_role(secret) 키, DB 비밀번호, 카카오 REST/Admin 키, 네이버 Client Secret
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# 지도: kakao 또는 naver (비우면 키가 있는 쪽 자동 선택, 둘 다 없으면 지도 대신 주소 카드 표시)
VITE_MAP_PROVIDER=kakao
# Kakao Developers → 내 애플리케이션 → 앱 키 → JavaScript 키
VITE_KAKAO_MAP_KEY=
# NAVER Cloud Platform → Maps → Application → Client ID
VITE_NAVER_MAP_CLIENT_ID=

# 카카오톡 공유용 JavaScript 키. 비우면 VITE_KAKAO_MAP_KEY 를 재사용합니다.
VITE_KAKAO_SHARE_KEY=

# 배포 주소 (OG 이미지 절대경로용). GitHub Actions 에서는 자동 설정되므로 로컬 빌드 때만 필요
# 예: https://username.github.io/wedding
VITE_SITE_URL=

# 로컬에서 GitHub Pages 와 같은 하위 경로로 빌드해 보고 싶을 때 (예: /wedding/)
# BASE_PATH=/
